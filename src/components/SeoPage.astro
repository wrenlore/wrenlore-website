---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
interface Props { page: { slug: string; title: string; metaTitle: string; description: string; intro: string; problem: string; points: readonly { title: string; body: string }[]; comparison?: readonly { label: string; wrenlore: string; conventional: string }[]; questions: readonly { question: string; answer: string }[] } }
const { page } = Astro.props;
const schema = { '@context': 'https://schema.org', '@type': 'WebPage', name: page.metaTitle, description: page.description, url: new URL(`/${page.slug}/`, Astro.site).href, isPartOf: { '@type': 'WebSite', name: 'WrenLore', url: Astro.site }, about: { '@type': 'SoftwareApplication', name: 'WrenLore', applicationCategory: 'BusinessApplication' } };
---
<BaseLayout title={page.metaTitle} description={page.description} canonical={`/${page.slug}/`} schema={schema}>
  <Header />
  <main>
    <section class="page-hero shell narrow">
      <p class="breadcrumb"><a href="/">WrenLore</a><span>/</span>{page.title}</p>
      <h1>{page.title}</h1><p class="lead">{page.intro}</p>
      <div class="hero-actions"><a class="button button-primary button-large" href="https://github.com/wrenlore/wrenlore">View the source</a><a class="button button-secondary button-large" href="https://github.com/wrenlore/wrenlore/blob/master/README-deploy.md">Deployment guide</a></div>
    </section>
    <section class="section shell narrow prose-intro"><h2>{page.problem}</h2><div class="detail-grid">{page.points.map((point) => <article><h3>{point.title}</h3><p>{point.body}</p></article>)}</div></section>
    {page.comparison && <section class="section section-ink"><div class="shell narrow"><h2>What changes with WrenLore</h2><div class="comparison-table"><div class="comparison-head"><span></span><b>WrenLore</b><b>Conventional SaaS wiki</b></div>{page.comparison.map((row) => <div class="comparison-row"><strong>{row.label}</strong><span>{row.wrenlore}</span><span>{row.conventional}</span></div>)}</div></div></section>}
    <section class="section shell narrow faq-section"><h2>Questions teams ask</h2>{page.questions.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
    <section class="closing-cta shell narrow"><h2>Run your knowledge base on your infrastructure.</h2><p>WrenLore is open source, self-hosted and available under AGPL-3.0.</p><a class="button button-primary button-large" href="https://github.com/wrenlore/wrenlore">Get WrenLore on GitHub</a></section>
  </main>
  <Footer />
</BaseLayout>
