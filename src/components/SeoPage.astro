---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ProductScreenshot from './ProductScreenshot.astro';
interface Props { page: { slug: string; title: string; metaTitle: string; description: string; intro: string; problem: string; points: readonly { title: string; body: string }[]; screenshot?: { src: string; alt: string; caption: string }; deepDive?: readonly { eyebrow: string; title: string; body: readonly string[]; bullets?: readonly string[]; link?: { label: string; href: string } }[]; comparisonTitle?: string; comparisonLabel?: string; comparison?: readonly { label: string; wrenlore: string; conventional: string }[]; limitations?: readonly string[]; questions: readonly { question: string; answer: string }[] } }
const { page } = Astro.props;
const schema = { '@context': 'https://schema.org', '@type': 'WebPage', name: page.metaTitle, description: page.description, url: new URL(`/${page.slug}/`, Astro.site).href, isPartOf: { '@type': 'WebSite', name: 'WrenLore', url: Astro.site }, about: { '@type': 'SoftwareApplication', name: 'WrenLore', applicationCategory: 'BusinessApplication' } };
---
<BaseLayout title={page.metaTitle} description={page.description} canonical={`/${page.slug}/`} schema={schema}>
  <Header />
  <main>
    <section class="page-hero shell narrow">
      <p class="breadcrumb"><a href="/">WrenLore</a><span>/</span>{page.title}</p>
      <h1>{page.title}</h1><p class="lead">{page.intro}</p>
      <div class="hero-actions"><a class="button button-primary button-large" href="https://github.com/wrenlore/wrenlore">View the source</a><a class="button button-secondary button-large" href="https://github.com/wrenlore/wrenlore/blob/master/README-deploy.md">Deployment guide</a></div>
    </section>
    <section class="section shell narrow prose-intro"><h2>{page.problem}</h2><div class="detail-grid">{page.points.map((point) => <article><h3>{point.title}</h3><p>{point.body}</p></article>)}</div></section>
    {page.screenshot && <section class="product-proof shell narrow"><ProductScreenshot src={page.screenshot.src} alt={page.screenshot.alt} caption={page.screenshot.caption} /></section>}
    {page.deepDive?.map((section, index) => <section class:list={["section", index % 2 === 0 && "section-soft"]}><div class="shell narrow content-section"><p class="eyebrow">{section.eyebrow}</p><h2>{section.title}</h2><div class="content-copy">{section.body.map((paragraph) => <p>{paragraph}</p>)}</div>{section.bullets && <ul class="evidence-list">{section.bullets.map((item) => <li>{item}</li>)}</ul>}{section.link && <p class="source-link"><a href={section.link.href}>{section.link.label} <span aria-hidden="true">→</span></a></p>}</div></section>)}
    {page.comparison && <section class="section section-ink"><div class="shell narrow"><h2>{page.comparisonTitle ?? 'What changes with WrenLore'}</h2><div class="comparison-table"><div class="comparison-head"><span></span><b>WrenLore</b><b>{page.comparisonLabel ?? 'Conventional SaaS wiki'}</b></div>{page.comparison.map((row) => <div class="comparison-row"><strong>{row.label}</strong><span>{row.wrenlore}</span><span>{row.conventional}</span></div>)}</div></div></section>}
    {page.limitations && <section class="section shell narrow limitations"><p class="eyebrow">Before you migrate</p><h2>Where WrenLore may not be the right fit</h2><p>A serious comparison should include the awkward bits. Check these against your own requirements before moving production knowledge.</p><ul class="evidence-list">{page.limitations.map((item) => <li>{item}</li>)}</ul></section>}
    <section class="section shell narrow faq-section"><h2>Questions teams ask</h2>{page.questions.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
    <section class="closing-cta shell narrow"><h2>Run your knowledge base on your infrastructure.</h2><p>WrenLore is open source, self-hosted and available under AGPL-3.0.</p><a class="button button-primary button-large" href="https://github.com/wrenlore/wrenlore">Get WrenLore on GitHub</a></section>
  </main>
  <Footer />
</BaseLayout>
